# wSpec generated / runtime files
wspec/state.json
wspec/state.json.lock
wspec/.state.*.tmp

# Per-transcript cursor for effort/cost tracking — ephemeral and machine-local; the durable
# records are wspec/changes/<id>/usage.json and wspec/usage-log.jsonl, both committed.
wspec/usage-cursor.json

# Ticket-mirror receipt + prelude cache (body_hash, posted event dedup) — machine-local
# bookkeeping, not evidence; the durable link lives in metadata.yaml's issue:/issue_url:.
wspec/changes/*/.ticket/
wspec/archive/*/.ticket/

# Forge capability probe cache (CLI presence/auth/feature discovery) — re-probed as needed.
wspec/.cache/

# memsearch tool cache
.memsearch/

# remember plugin history
.remember/

# internal workflow/cost audit - not release material
WSPEC-WORKFLOW-ANALYSIS.md
