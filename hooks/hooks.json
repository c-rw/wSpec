{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/wspec/mcp/dist/cli.js state:banner"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/wspec/mcp/dist/cli.js state:banner"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/wspec/mcp/dist/cli.js hook:guard-edit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__(plugin_wspec_)?wspec__wspec[._](markTask|setStatus|syncSpec)",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/wspec/mcp/dist/cli.js state:sync"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/wspec/mcp/dist/cli.js hook:validate-analysis-write"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/wspec/mcp/dist/cli.js hook:pre-compact-sync"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/wspec/mcp/dist/cli.js hook:nudge-validate"
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/wspec/mcp/dist/cli.js hook:usage-track"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/wspec/mcp/dist/cli.js hook:session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
