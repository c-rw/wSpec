#!/usr/bin/env sh
set -eu

HOOK_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if ! command -v node >/dev/null 2>&1; then
	exit 0
fi

if [ -f "$HOOK_DIR/.wspec-mcp-cli-path" ]; then
	CLI_PATH="$(cat "$HOOK_DIR/.wspec-mcp-cli-path")"
else
	CLI_PATH="$(CDPATH= cd -- "$HOOK_DIR/../.." && pwd)/mcp/dist/cli.js"
fi

exec node "$CLI_PATH" hook:prepare-commit-msg "$@"
